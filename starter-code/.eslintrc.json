{
    "env": {
        "browser": true,
        "es2021": true
    },
    "globals": {
        "$": "readonly",
        "jQuery": "readonly"
    },
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "extends": ["eslint:recommended"],
    "rules": {
        "complexity": ["warn", 10],
        "no-console": "warn",
        "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
        "eqeqeq": ["error", "always"],
        "no-var": "error",
        "prefer-const": "warn"
    }
}
