{
  "schemaVersion": "1.0",
  "templateSlug": "cv-spa-jquery-rest",
  "evaluationBlocks": [
    {
      "blockId": "auto",
      "evaluationType": "automated_pipeline",
      "metrics": [
        {
          "metricKey": "lighthouse_performance",
          "worker": "LighthouseRunner",
          "weight": 25,
          "threshold": 0.85,
          "config": {
            "url": "http://localhost:4173",
            "category": "performance",
            "minScore": 85
          }
        },
        {
          "metricKey": "lighthouse_accessibility",
          "worker": "LighthouseRunner",
          "weight": 20,
          "threshold": 0.9,
          "config": {
            "url": "http://localhost:4173",
            "category": "accessibility",
            "minScore": 90
          }
        },
        {
          "metricKey": "lint_violations",
          "worker": "BuildRunner",
          "weight": 20,
          "threshold": 1.0,
          "config": {
            "command": "npx eslint js/ --format=json",
            "maxErrors": 0
          }
        },
        {
          "metricKey": "error_handler_presence",
          "worker": "StaticAnalyzer",
          "weight": 15,
          "threshold": 1.0,
          "config": {
            "file": "starter-code/js/api.js",
            "requiredPatterns": [".catch(|try.*{|catch.*Error"]
          }
        },
        {
          "metricKey": "e2e_tests_presence",
          "worker": "StaticAnalyzer",
          "weight": 15,
          "threshold": 1.0,
          "config": {
            "dir": "starter-code/tests/e2e",
            "requiredPattern": "test\\(",
            "forbiddenPattern": "test\\.skip"
          }
        },
        {
          "metricKey": "cyclomatic_complexity",
          "worker": "BuildRunner",
          "weight": 5,
          "threshold": 1.0,
          "config": {
            "command": "npx eslint js/ --rule '{\"complexity\": [\"error\", 10]}' --format=json",
            "maxErrors": 0
          }
        }
      ]
    },
    {
      "blockId": "external_url",
      "evaluationType": "manual_review",
      "inputBlock": {
        "block_type": "external_url",
        "label": "URL de la SPA desplegada",
        "placeholder": "https://usuario.github.io/workshop-spa"
      }
    }
  ]
}
